# API ключи
NEUROAPI_API_KEY=
GLM_API_KEY=
YANDEX_DISK_TOKEN=
GIGACHAT_SECRET=
GIGACHAT_AUTH_TOKEN=

# HuggingFace (для скачивания моделей без rate limit)
# Получить: https://huggingface.co/settings/tokens (достаточно Read)
HF_TOKEN=

# Qdrant (опционально, по умолчанию localhost:6333)
# Запуск: docker compose up -d
QDRANT_HOST=localhost
QDRANT_PORT=6333

# arXiv API (email для User-Agent — снижает шанс 429)
# См.: https://arxiv.org/help/api/tou
ARXIV_EMAIL=you@example.com
