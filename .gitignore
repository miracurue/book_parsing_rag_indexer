# Секреты
.env
.streamlit/secrets.toml

# Данные (локальные; сканы учебников защищены авторским правом)
data/*
!data/books/
data/books/*
!data/books/.gitkeep
!data/articles/
data/articles/*
!data/articles/raw/
data/articles/raw/*
!data/articles/raw/.gitkeep
