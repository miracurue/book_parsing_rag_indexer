data/vector_db/*
!data/vector_db/.gitkeep

# Векторная БД
**/vector_db/*
!data/vector_db/.gitkeep

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.pytest_cache/

# Логи и временные файлы
*.log

# ОС / IDE
*:Zone.Identifier
.DS_Store
Thumbs.db
.idea/
.vscode/
